{
  "name": "@tsci/AnasSarkiz.NEMA11_RP2040_Compact_Prototype",
  "version": "0.6.7-reference-refactor-wip",
  "private": false,
  "type": "module",
  "description": "WIP two-layer NEMA11 controller with required buzzer, imported JLCPCB components; unrouted until validation gates pass",
  "main": "index.circuit.tsx",
  "scripts": {
    "build": "tsci build index.circuit.tsx --pcb-png --pcb-svgs --schematic-svgs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write index.circuit.tsx assets.d.ts package.json tsconfig.json tscircuit.config.json \"config/*.json\" README.md VALIDATION.md",
    "format:check": "prettier --check index.circuit.tsx assets.d.ts package.json tsconfig.json tscircuit.config.json \"config/*.json\" README.md VALIDATION.md",
    "check:netlist": "tsci check netlist index.circuit.tsx",
    "check:pins": "tsci check pin_specification index.circuit.tsx",
    "check:source": "tsci check source index.circuit.tsx",
    "check:schematic": "tsci check schematic-placement index.circuit.tsx",
    "check:placement": "tsci check placement index.circuit.tsx",
    "check:imports": "python3 scripts/audit_component_refresh.py --evidence-dir checks/20261023",
    "check:usb-locator": "python3 scripts/check_usb_locator_holes.py imports/USB4145_03_0070_C/USB4145_03_0070_C.tsx --output checks/20261108-reconstruction/usb-locator.json",
    "export:schematic-pdf": "node scripts/export_a4_schematics.mjs && python3 scripts/export_a4_pdf.py",
    "verify": "python3 scripts/run_milestone_checks.py",
    "source:generate": "python3 scripts/generate_source.py",
    "source:check": "python3 scripts/generate_source.py --check",
    "test:prebuild": "python3 -m unittest discover -s tests -v",
    "check:contracts": "python3 scripts/check_nema14_alignment.py",
    "check:reference-complete": "python3 scripts/check_nema14_alignment.py --require-complete",
    "verify:offline": "npm run check:contracts && npm run test:prebuild && npm run source:check && npm run typecheck && npm run format:check"
  },
  "dependencies": {
    "@tscircuit/cli": "0.1.2446",
    "tscircuit": "0.0.3121",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "@types/react": "19.1.16",
    "@types/node": "22.18.6",
    "bun": "1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnasSarkiz/NEMA11_RP2040.git"
  }
}
