# Preserve supplier files byte-for-byte, including original CRLF and formatting.
imports/supplier/** -text -whitespace
imports/supplier/**/*.step binary
imports/supplier/**/*.obj binary
imports/supplier/**/*.tsx.original -diff
*.pdf binary
*.glb binary

imports/motor/**/*.step binary
# Standard CSV exports retain the CSV writer's CRLF line endings.
*.csv whitespace=cr-at-eol
# Keep native exporter SVG formatting intact for registry file comparisons.
prototypes/compact-current/dist/**/*.svg -whitespace
