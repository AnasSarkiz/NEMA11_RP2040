{
  "name": "NEMA11_RP2040",
  "version": "0.4.0-dev",
  "private": true,
  "type": "module",
  "description": "Native tscircuit 28 mm four-corner all-top controller development; buzzer omitted with user authorization; routing and manufacturing qualification incomplete",
  "scripts": {
    "core:build": "bun scripts/build-core.tsx",
    "core:check": "python3 scripts/verify_core.py",
    "core:schematic": "python3 scripts/schematic_core.py && bun scripts/render-core.tsx && tsci check schematic-placement artifacts/rp2040-core/core-schematic.circuit.json > artifacts/rp2040-core/native-schematic-placement.txt && python3 scripts/verify_core_schematic.py && /workspace/.venvs/nema11-cad/bin/python scripts/export-core-pdf.py",
    "core:3d": "bun scripts/export-core-3d.tsx",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "pcb:route": "/workspace/.venvs/nema11-cad/bin/python scripts/route_core_pcb.py",
    "pcb:check": "bun scripts/check-render-pcb.tsx && /workspace/.venvs/nema11-cad/bin/python scripts/audit_core_pcb.py && /workspace/.venvs/nema11-cad/bin/python scripts/audit_core_clock.py",
    "pcb:3d": "bun scripts/export-core-3d.tsx --pcb",
    "pcb:dev": "tsci dev artifacts/rp2040-pcb/board.circuit.json",
    "pcb:test": "/workspace/.venvs/nema11-cad/bin/python -m unittest discover -s tests-pcb -v",
    "pcb:cam-review": "bun scripts/export-pcb-review-cam.tsx && /workspace/.venvs/nema11-cam/bin/python scripts/audit_core_cam.py",
    "pcb:shorts": "tsci check shorts artifacts/rp2040-pcb/board.circuit.json --mode gerber --layer all --pixels-per-mm 100",
    "pcb:prototype": "python3 scripts/prepare-core-prototype.py",
    "prototype:dev": "tsci dev prototypes/rp2040-core/index.circuit.json",
    "pcb:cam-render": "/workspace/.venvs/nema11-cam/bin/python scripts/render_core_cam.py",
    "controller:build": "bun scripts/build-controller.tsx",
    "controller:check": "python3 scripts/verify_controller.py",
    "controller:3d": "bun scripts/export-core-3d.tsx --controller",
    "controller:schematic": "bun scripts/schematic-controller.tsx && python3 scripts/verify_controller_schematic.py",
    "controller:pcb": "/workspace/.venvs/nema11-cad/bin/python scripts/build_controller_pcb.py --check",
    "controller:assembly": "bun scripts/build-controller-assembly.tsx --pcb && bun scripts/export-core-3d.tsx --assembly && /workspace/.venvs/nema11-cad/bin/python scripts/verify_controller_3d.py",
    "controller:dev": "tsci dev artifacts/compact-four-mounts/assembly.circuit.json",
    "controller:drc": "python3 scripts/apply_native_keepout_fix.py --check && bun scripts/check-controller-pcb.tsx --checks-only",
    "controller:connectivity": "/workspace/.venvs/nema11-cad/bin/python scripts/audit_controller_connectivity.py",
    "native:test": "bun test tests-native",
    "controller:baseline:dev": "tsci dev artifacts/controller/assembly.circuit.json",
    "compact:build": "bun scripts/build-controller.tsx --compact",
    "compact:check": "python3 scripts/verify_controller.py --compact && /workspace/.venvs/nema11-cad/bin/python scripts/audit_compact_placement.py && python3 scripts/verify_compact_milestone.py",
    "compact:schematic": "bun scripts/schematic-controller.tsx --compact && /workspace/.venvs/nema11-cad/bin/python scripts/verify_controller_schematic.py --compact && /workspace/.venvs/nema11-cad/bin/python scripts/export-core-pdf.py --compact",
    "compact:3d": "bun scripts/build-controller-assembly.tsx --compact && bun scripts/export-core-3d.tsx --compact --assembly && python3 scripts/verify_controller_3d.py --compact",
    "compact:dev": "tsci dev artifacts/compact-controller/assembly.circuit.json",
    "escape:dev": "tsci dev artifacts/compact-escape/assembly.circuit.json",
    "escape:check": "/workspace/.venvs/nema11-cad/bin/python scripts/verify_compact_escape.py",
    "four-mounts:dev": "tsci dev artifacts/compact-four-mounts/assembly.circuit.json",
    "four-mounts:check": "python3 scripts/verify_four_mounts.py --assembly"
  },
  "main": "artifacts/compact-four-mounts/assembly.circuit.json"
}
